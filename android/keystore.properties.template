# ─── Ace Chasers · Upload Signing Config ───────────────────────────
# COPY this file to `keystore.properties` on your local machine and
# fill in the four values below. `keystore.properties` is git-ignored
# so your secrets never land in the repo.
#
# If you don't have a keystore yet, generate one:
#   keytool -genkey -v \
#     -keystore ~/keystores/acechasers-upload.jks \
#     -alias acechasers-upload \
#     -keyalg RSA -keysize 2048 -validity 25000
#
# Then upload it to Play Console → Setup → App Integrity → Upload key
# and note the same passwords + alias here.

storeFile=/absolute/path/to/acechasers-upload.jks
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyAlias=acechasers-upload
keyPassword=REPLACE_WITH_KEY_PASSWORD
